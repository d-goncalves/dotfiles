# Optional tools, only installed with: ./bootstrap.sh --extras
# Homelab and infrastructure
brew "ansible"
brew "terraform"
brew "helm"
brew "fluxcd/tap/flux"
brew "docker"

# Language servers for nvim. Missing ones are skipped quietly, so install what you use.
# Not in Homebrew: nil (nix), tflint, clangd and typescript-language-server come from elsewhere.
brew "bash-language-server"
brew "dhall-lsp-server"
brew "docker-compose-langserver"
brew "lua-language-server"
brew "pyright"
brew "python-lsp-server"
brew "rust-analyzer"
brew "terraform-ls"
brew "ty"
brew "typos-lsp"
brew "yaml-language-server"

# Handy extras
brew "git-delta"
brew "ncdu"
brew "nmap"
brew "watch"
brew "ssh-copy-id"
brew "cmake"
brew "graphviz"
brew "poppler"
brew "protobuf"
brew "rust"

# macOS only
brew "batt" if OS.mac?
cask "1password-cli" if OS.mac?
cask "claude-code" if OS.mac?
cask "libreoffice" if OS.mac?
